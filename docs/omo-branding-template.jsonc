{
  "$comment": "HyperCode 品牌覆盖层:子代理显示名(内部 ID 不变,钩子/路由零影响)。安装器预写此文件。",
  "agents": {
    "sisyphus":          { "displayName": "Lead",       "description": "Lead engineer: decomposes and executes development tasks" },
    "sisyphus-junior":   { "displayName": "Worker",     "description": "Worker: completes individual subtasks" },
    "oracle":            { "displayName": "Architect",  "description": "Read-only consultant for hard problems" },
    "momus":             { "displayName": "Reviewer",   "description": "Reviews plans and deliverables" },
    "prometheus":        { "displayName": "Planner",    "description": "Exploratory task planning" },
    "metis":             { "displayName": "Analyst",    "description": "Requirement and ambiguity analysis" },
    "librarian":         { "displayName": "Researcher", "description": "External documentation and reference research" },
    "explore":           { "displayName": "Scout",      "description": "Codebase exploration and location" },
    "hephaestus":        { "displayName": "Builder",    "description": "Default build and implementation agent" },
    "atlas":             { "displayName": "Mapper",     "description": "Code map and navigation" },
    "multimodal-looker": { "displayName": "Looker",     "description": "Image and document content analysis" }
  }
