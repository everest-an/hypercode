{
  "expo": {
    "name": "HyperCode AI",
    "slug": "hypercode",
    "icon": "./assets/icon.png",
    "scheme": "hypercode",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.awareliquid.hypercode.ios",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "HyperCode connects to your computer on the same network to open your workspace.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "app.hypercode.mobile",
      "versionCode": 2,
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "name": "HyperCode - a little room for everything"
    },
    "plugins": [
      "expo-document-picker",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ]
  }
}
