{
  "expo": {
    "name": "HyperCode Remote",
    "slug": "hypercode",
    "scheme": "hypercode",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.hypercode.mobile",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.hypercode.mobile",
      "versionCode": 1
    },
    "web": { "bundler": "metro", "name": "HyperCode - a little room for everything" },
    "plugins": [
      "expo-document-picker",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ]
  }
}