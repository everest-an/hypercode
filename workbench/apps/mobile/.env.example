# Base URL of the workbench server the app talks to.
# Development: http://localhost:8787 (iOS simulator) or http://10.0.2.2:8787 (Android emulator)
# Release builds: a public HTTPS origin, e.g. https://<workbench-host>
# Required for App Store / TestFlight builds - without it the app falls back to localhost and cannot connect.
EXPO_PUBLIC_API_URL=