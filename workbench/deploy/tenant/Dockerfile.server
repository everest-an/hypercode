# syntax=docker/dockerfile:1.7
# ============================================================
# HyperCode server 镜像（T1a）
# 构建上下文 = workbench/ 根目录：
#   docker build -f deploy/tenant/Dockerfile.server -t hypercode-server:local .
#
# 关键点：
# - 内置 docker CLI：server 会用 `spawn("docker", ...)` 创建 computer 容器
# - 运行时通过 DOCKER_HOST 指向【本租户的 rootless docker】，绝不碰宿主 root socket
# - 以非 root(1000) 运行；实际部署时建议 user: <TENANT_UID>:<TENANT_GID> 以对齐 socket 权限
# ============================================================

FROM docker:27-cli AS dockercli

FROM node:22-bookworm-slim AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.build.json ./
COPY apps/server ./apps/server
COPY packages ./packages
# 只装根包依赖（server 属根 workspace；不拉 mobile/worker 的重依赖）
RUN corepack enable && pnpm install --frozen-lockfile --filter hypercode
RUN pnpm build:server

FROM node:22-bookworm-slim AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tini \
 && rm -rf /var/lib/apt/lists/*
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /app
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
ENV NODE_ENV=production
USER 1000:1000
EXPOSE 8787
ENTRYPOINT ["tini","--"]
CMD ["node","dist/apps/server/src/index.js"]
