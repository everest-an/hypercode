{
  // HyperCode 引擎配置 —— 由安装向导自动生成,请勿手改(要换 key 直接重跑安装向导)。
  "plugin": ["oh-my-openagent"],
  // 全局规则:任何交付物都必须经过溯源比对自检(见 hc-verify 技能)。
  "instruction": [
    "交付任何文档、报告、PPT、邮件或代码注释前,必须执行溯源比对(hc-verify 技能):把产出中的每一个事实性陈述(数字、金额、日期、人名、机构名、条款、法条、引用、代码行为)与用户提供的源材料逐条比对;能溯源的记录出处,无法溯源的显式标注【推断】或删除,与源材料矛盾的一律以源材料为准修正;交付时附溯源表。宁删勿错,推断必须显式标注,禁止把模型补全的内容混入事实。"
  ],
  // 模型:DeepSeek(自带 key,全体子代理共享)
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "__HC_API_KEY__"
      },
      "models": {
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash" }
      }
    }
  },
  "model": "deepseek/deepseek-v4-pro"
}
