    "prometheus":        { "displayName": "Planner",    "description": "Exploratory task planning", "models": ["deepseek/deepseek-v4-pro"] },
    "metis":             { "displayName": "Analyst",    "description": "Requirement and ambiguity analysis", "models": ["deepseek/deepseek-v4-pro"] },
    "librarian":         { "displayName": "Researcher", "description": "External documentation and reference research", "models": ["deepseek/deepseek-v4-flash"] },
    "explore":           { "displayName": "Scout",      "description": "Codebase exploration and location", "models": ["deepseek/deepseek-v4-flash"] },
    "hephaestus":        { "displayName": "Builder",    "description": "Default build and implementation agent", "models": ["deepseek/deepseek-v4-pro"] },
